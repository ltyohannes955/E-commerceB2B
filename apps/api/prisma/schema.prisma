generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  fullName          String
  email             String               @unique @db.VarChar(320)
  phone             String?              @db.VarChar(32)
  passwordHash      String
  role              UserRole             @default(CUSTOMER)
  status            UserStatus           @default(ACTIVE)
  lastLoginAt       DateTime?
  termsAcceptedAt   DateTime
  privacyAcceptedAt DateTime
  legalVersion      String               @default("phase1-draft")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  actedAuditLogs    AuditLog[]           @relation("AuditActor")
  targetAuditLogs   AuditLog[]           @relation("AuditTarget")
  cart              Cart?
  rfqs              Rfq[]                @relation("CustomerRfqs")
  assignedRfqs      Rfq[]                @relation("AssignedRfqs")
  quotesCreated     Quote[]              @relation("QuoteCreator")
  rfqStatusHistory  RfqStatusHistory[]   @relation("RfqStatusActor")
  quoteStatusHistory QuoteStatusHistory[] @relation("QuoteStatusActor")

  @@index([status, createdAt])
  @@index([role, createdAt])
}

model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique
  familyId            String    @db.Uuid
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?   @db.Uuid
  lastUsedAt          DateTime?
  userAgent           String?   @db.VarChar(512)
  ipAddress           String?   @db.VarChar(64)
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  targetUserId String?  @db.Uuid
  action       String   @db.VarChar(80)
  metadata     Json?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(512)
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

enum ProductKind {
  SIMPLE
  CONFIGURABLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductAvailability {
  IN_STOCK
  AVAILABLE_TO_ORDER
  PRE_ORDER
  OUT_OF_STOCK
  DISCONTINUED
}

enum ProductSaleMode {
  DIRECT_PURCHASE
  RFQ_ONLY
  HYBRID
}

enum ProductPriceVisibility {
  SHOW_PRICE
  HIDE_PRICE
}

enum VariantPriceMode {
  INHERIT
  ADJUSTMENT
  FIXED
}

enum RfqStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  CANCELLED
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  REPLACED
}

enum QuoteAdjustmentKind {
  CHARGE
  DISCOUNT
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(160)
  description String?    @db.Text
  parentId    String?    @db.Uuid
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, sortOrder])
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                        String                 @id @default(uuid()) @db.Uuid
  name                      String                 @db.VarChar(240)
  slug                      String                 @unique @db.VarChar(180)
  shortDescription          String?                @db.VarChar(500)
  fullDescription           String?                @db.Text
  categoryId                String                 @db.Uuid
  brandId                   String?                @db.Uuid
  internalSku               String                 @unique @db.VarChar(100)
  unit                      String                 @db.VarChar(40)
  countryOfOrigin           String                 @db.Char(2)
  minimumOrderQuantity      Int                    @default(1)
  leadTimeDays              Int?
  leadTimeNote              String?                @db.VarChar(240)
  availability              ProductAvailability    @default(AVAILABLE_TO_ORDER)
  saleMode                  ProductSaleMode        @default(DIRECT_PURCHASE)
  priceVisibility           ProductPriceVisibility @default(SHOW_PRICE)
  currency                  String                 @default("ETB") @db.Char(3)
  regularPrice              Decimal?               @db.Decimal(14, 2)
  discountPrice             Decimal?               @db.Decimal(14, 2)
  discountStartAt           DateTime?
  discountEndAt             DateTime?
  showStartingFrom          Boolean                @default(false)
  allowRfqAtAnyQuantity     Boolean                @default(false)
  directPurchaseMaxQuantity Int?
  rfqThreshold              Int?
  productKind               ProductKind            @default(SIMPLE)
  featured                  Boolean                @default(false)
  status                    ProductStatus          @default(DRAFT)
  seoTitle                  String?                @db.VarChar(240)
  seoDescription            String?                @db.VarChar(500)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  category                  Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                     Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants                  ProductVariant[]
  images                    ProductImage[]
  specifications            ProductSpecification[]
  priceTiers                PriceTier[]
  cartItems                 CartItem[]
  rfqItems                  RfqItem[]

  @@index([status, featured, createdAt])
  @@index([status, categoryId, createdAt])
  @@index([status, brandId, createdAt])
  @@index([status, availability, createdAt])
  @@index([status, saleMode, createdAt])
}

model ProductVariant {
  id                String              @id @default(uuid()) @db.Uuid
  productId         String              @db.Uuid
  sku               String              @unique @db.VarChar(100)
  name              String              @db.VarChar(160)
  attributes        Json
  priceMode         VariantPriceMode    @default(INHERIT)
  priceAdjustment   Decimal?            @db.Decimal(14, 2)
  fixedPrice        Decimal?            @db.Decimal(14, 2)
  availability      ProductAvailability @default(AVAILABLE_TO_ORDER)
  availableQuantity Int?
  imageId           String?             @db.Uuid
  isDefault         Boolean             @default(false)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  image             ProductImage?       @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  priceTiers        PriceTier[]
  cartItems         CartItem[]
  rfqItems          RfqItem[]

  @@index([productId, sortOrder])
  @@index([productId, availability])
}

model ProductImage {
  id               String           @id @default(uuid()) @db.Uuid
  productId        String           @db.Uuid
  data             String           @db.Text
  mimeType         String           @db.VarChar(80)
  originalFileName String           @db.VarChar(255)
  byteSize         Int
  altText          String           @db.VarChar(240)
  sortOrder        Int              @default(0)
  isPrimary        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants         ProductVariant[] @relation("VariantImage")

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductSpecification {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  groupName String   @db.VarChar(100)
  name      String   @db.VarChar(120)
  value     String   @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, groupName, sortOrder])
}

model PriceTier {
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @db.Uuid
  variantId       String?         @db.Uuid
  minimumQuantity Int
  unitPrice       Decimal         @db.Decimal(14, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, minimumQuantity])
  @@index([variantId, minimumQuantity])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id                String          @id @default(uuid()) @db.Uuid
  cartId            String          @db.Uuid
  productId         String?         @db.Uuid
  variantId         String?         @db.Uuid
  productName       String          @db.VarChar(240)
  variantName       String          @db.VarChar(160)
  sku               String          @db.VarChar(100)
  unit              String          @db.VarChar(40)
  imageSrc          String?
  quantity          Int
  unitPriceSnapshot Decimal         @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Rfq {
  id                String            @id @default(uuid()) @db.Uuid
  reference         String            @unique @db.VarChar(40)
  title             String            @db.VarChar(120)
  userId            String            @db.Uuid
  assignedAdminId   String?           @db.Uuid
  status            RfqStatus         @default(DRAFT)
  version           Int               @default(1)
  message           String?           @db.Text
  deliveryTimeframe String?           @db.VarChar(160)
  deliveryCity      String?           @db.VarChar(120)
  preferredContact  String?           @db.VarChar(40)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  submittedAt       DateTime?
  cancelledAt       DateTime?
  user              User              @relation("CustomerRfqs", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin     User?             @relation("AssignedRfqs", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  items             RfqItem[]
  statusHistory     RfqStatusHistory[]
  quotes            Quote[]

  @@index([userId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([assignedAdminId, status, updatedAt])
}

model RfqItem {
  id                String          @id @default(uuid()) @db.Uuid
  rfqId             String          @db.Uuid
  productId         String?         @db.Uuid
  variantId         String?         @db.Uuid
  productName       String          @db.VarChar(240)
  variantName       String          @db.VarChar(160)
  sku               String          @db.VarChar(100)
  unit              String          @db.VarChar(40)
  imageSrc          String?
  requestedQuantity Int
  adjustedQuantity  Int?
  adjustmentReason  String?         @db.VarChar(500)
  note              String?         @db.VarChar(1000)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  rfq               Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quoteItems        QuoteItem[]

  @@unique([rfqId, variantId])
  @@index([productId])
  @@index([variantId])
}

model RfqStatusHistory {
  id          String    @id @default(uuid()) @db.Uuid
  rfqId       String    @db.Uuid
  actorUserId String?   @db.Uuid
  fromStatus  RfqStatus?
  toStatus    RfqStatus
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  rfq         Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  actor       User?     @relation("RfqStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rfqId, createdAt])
}

model Quote {
  id                    String              @id @default(uuid()) @db.Uuid
  quoteNumber           String              @unique @db.VarChar(48)
  rfqId                 String              @db.Uuid
  createdById           String              @db.Uuid
  revision              Int
  version               Int                 @default(1)
  status                QuoteStatus         @default(DRAFT)
  currency              String              @default("ETB") @db.Char(3)
  subtotal              Decimal             @db.Decimal(14, 2)
  adjustmentTotal       Decimal             @db.Decimal(14, 2)
  grandTotal             Decimal             @db.Decimal(14, 2)
  estimatedLeadTimeDays Int?
  paymentTerms          String?             @db.VarChar(240)
  expiresAt             DateTime?
  customerNotes         String?             @db.Text
  internalNotes         String?             @db.Text
  declineReason         String?             @db.VarChar(500)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  sentAt                DateTime?
  acceptedAt            DateTime?
  declinedAt            DateTime?
  rfq                   Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  createdBy             User                @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items                 QuoteItem[]
  adjustments           QuoteAdjustment[]
  statusHistory         QuoteStatusHistory[]

  @@unique([rfqId, revision])
  @@index([status, updatedAt])
  @@index([rfqId, createdAt])
}

model QuoteItem {
  id           String    @id @default(uuid()) @db.Uuid
  quoteId      String    @db.Uuid
  rfqItemId    String?   @db.Uuid
  productName  String    @db.VarChar(240)
  variantName  String    @db.VarChar(160)
  sku          String    @db.VarChar(100)
  unit         String    @db.VarChar(40)
  quantity     Int
  unitPrice    Decimal   @db.Decimal(14, 2)
  lineSubtotal Decimal   @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  quote        Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem      RfqItem?  @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model QuoteAdjustment {
  id        String              @id @default(uuid()) @db.Uuid
  quoteId   String              @db.Uuid
  kind      QuoteAdjustmentKind
  label     String              @db.VarChar(160)
  amount    Decimal             @db.Decimal(14, 2)
  sortOrder Int                 @default(0)
  quote     Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
}

model QuoteStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  quoteId     String      @db.Uuid
  actorUserId String?     @db.Uuid
  fromStatus  QuoteStatus?
  toStatus    QuoteStatus
  note        String?     @db.VarChar(500)
  createdAt   DateTime    @default(now())
  quote       Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor       User?       @relation("QuoteStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
}

model EmailOutbox {
  id           String            @id @default(uuid()) @db.Uuid
  kind         String            @db.VarChar(80)
  recipient    String            @db.VarChar(320)
  subject      String            @db.VarChar(240)
  payload      Json
  status       EmailOutboxStatus @default(PENDING)
  attempts     Int               @default(0)
  availableAt  DateTime          @default(now())
  lastError    String?           @db.VarChar(1000)
  sentAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, availableAt])
}
